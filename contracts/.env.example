# Copy to .env and fill in. .env is never committed.

# Network
QIE_MAINNET_RPC=https://rpc1mainnet.qie.digital
QIE_TESTNET_RPC=https://rpc1testnet.qie.digital

# Keys. Use fresh wallets that hold only a few dollars.
DEPLOYER_KEY=
JEWELLER_KEY=
CUSTOMER_KEY=

# QIE mainnet contracts (https://docs.qie.digital)
STABLECOIN=0x3F43DA82eC9A4f5285F10FaF1F26EcA7319E5DA5
GOLD_FEED=0x9aD0199a67588ee293187d26bA1BE61cb07A214c

# Set USE_MOCKS=true on chains without QIE's gold oracle (testnet, local)
USE_MOCKS=false
MOCK_GOLD_PRICE=409120116205
MOCK_PRICE_AGE=86400

# Registry limits every scheme must respect
LIMIT_MAX_EXIT_FEE_BPS=500
LIMIT_MIN_BOND_BPS=1000

# Price age is measured from the feed: longest gap over these rounds, times this factor
PRICE_AGE_LOOKBACK_ROUNDS=100
PRICE_AGE_SAFETY_BPS=15000

# Scheme settings for script/OpenScheme.s.sol
REGISTRY=
SCHEME_NAME="Asha Jewellers (demo)"
SCHEME_INSTALMENT_CENTS=100
SCHEME_INSTALMENT_COUNT=3
SCHEME_PERIOD=60
SCHEME_GRACE=600
SCHEME_DELIVERY_WINDOW=120
SCHEME_CURE_WINDOW=120
SCHEME_BONUS_BPS=900
SCHEME_BOND_BPS=1500
SCHEME_EXIT_FEE_BPS=200
